<ResourceDictionary x:Class="AyDesktop.Views.DesktopItemTemplates"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:AyDesktop.Views">

    <!-- 普通图标模板 -->
    <DataTemplate x:Key="NormalItemTemplate">
        <Border x:Name="ItemBorder"
            Width="96" Height="110"
            Background="Transparent"
            BorderThickness="1" BorderBrush="Transparent"
            CornerRadius="3"
            MouseLeftButtonDown="Item_MouseLeftButtonDown"
            MouseLeftButtonUp="Item_MouseLeftButtonUp"
            MouseMove="Item_MouseMove"
            MouseRightButtonDown="Item_MouseRightButtonDown"
            Tag="{Binding}">
            <StackPanel>
                <Grid>
                    <Image Source="{Binding Icon}" Width="48" Height="48"
                 Margin="0,8,0,6"/>
                    <Border Background="#333388FF"
                  CornerRadius="8" Padding="4,0"
                  HorizontalAlignment="Right" VerticalAlignment="Top"
                  Margin="0,6,18,0"
                  Visibility="Collapsed" x:Name="FolderBadge">
                        <TextBlock Text="夹" Foreground="White" FontSize="10"/>
                    </Border>
                </Grid>
                <TextBlock Text="{Binding DisplayName}"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap" TextAlignment="Center"
                   Foreground="White" FontSize="12"
                   Width="88" MaxHeight="20"
                   ToolTipService.InitialShowDelay="600"
                   ToolTipService.ShowDuration="20000"
                   ToolTip="{Binding Name}"/>
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#3D5AAFFF"/>
                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#7FB8D8FF"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                <Setter TargetName="FolderBadge" Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- 组模式文件夹模板（尺寸随子项数动态变化） -->
    <DataTemplate x:Key="GroupFolderTemplate">
        <Border x:Name="GroupBorder"
            Width="{Binding GroupWidth}"
            Height="{Binding GroupHeight}"
            Background="#22FFFFFF" BorderBrush="#55FFFFFF" BorderThickness="1.5"
            CornerRadius="10"
            MouseLeftButtonDown="Item_MouseLeftButtonDown"
            MouseLeftButtonUp="Item_MouseLeftButtonUp"
            MouseMove="Item_MouseMove"
            MouseRightButtonDown="Item_MouseRightButtonDown"
            Tag="{Binding}">
            <Grid>
                <TextBlock Text="{Binding Name}"
                   Foreground="White" FontSize="13" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Top"
                   Margin="0,8,0,0"
                   TextTrimming="CharacterEllipsis" Width="200"
                   TextAlignment="Center"/>

                <ItemsControl ItemsSource="{Binding Children}"
                      Margin="10,32,10,16"
                      Background="Transparent">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="{Binding GroupRows}"
                           Columns="{Binding GroupColumns}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- ★ 组内子项：可拖拽、双击、右键 -->
                            <Grid Background="Transparent"
                    Tag="{Binding}"
                    MouseLeftButtonDown="SubItem_MouseLeftButtonDown"
                    MouseLeftButtonUp="SubItem_MouseLeftButtonUp"
                    MouseMove="SubItem_MouseMove"
                    MouseRightButtonDown="SubItem_MouseRightButtonDown">
                                <StackPanel Margin="4">
                                    <Image Source="{Binding Icon}" Width="40" Height="40"
                         HorizontalAlignment="Center"
                         IsHitTestVisible="False"/>
                                    <TextBlock Text="{Binding DisplayName}"
                             FontSize="10" Foreground="#DDD"
                             TextAlignment="Center"
                             TextTrimming="CharacterEllipsis"
                             Width="80" Margin="0,2,0,0"
                             IsHitTestVisible="False"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="GroupBorder" Property="Background" Value="#3D5AAFFF"/>
                <Setter TargetName="GroupBorder" Property="BorderBrush" Value="#7FB8D8FF"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <local:DesktopItemTemplateSelector x:Key="ItemSelector"
      NormalTemplate="{StaticResource NormalItemTemplate}"
      GroupFolderTemplate="{StaticResource GroupFolderTemplate}"/>
</ResourceDictionary>