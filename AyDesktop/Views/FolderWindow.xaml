<Window x:Class="AyDesktop.Views.FolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文件夹" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Width="900" Height="620" ResizeMode="NoResize"
        KeyDown="Window_KeyDown">

  <!-- ★ 外层 Grid 包裹：模态时蒙层铺满，主内容框居中 -->
  <Grid>

    <!-- 模态蒙层：默认隐藏，模态时显示。点击关闭窗口 -->
    <Border x:Name="OverlayMask"
            Background="#A0000000"
            MouseLeftButtonDown="OverlayMask_MouseDown"
            Visibility="Collapsed"/>

    <!-- 主内容框：无论窗口多大，都固定 900×620 居中 -->
    <Border x:Name="MainBorder"
            Width="900" Height="620"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#F01E1E1E" CornerRadius="12"
            BorderBrush="#55FFFFFF" BorderThickness="1.5">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="48"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Margin="16,0" MouseLeftButtonDown="TitleBar_MouseDown">
          <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold"
                     Foreground="White" VerticalAlignment="Center"/>
          <Button Content="✕" Click="Close_Click"
                  Width="32" Height="32" FontSize="14"
                  HorizontalAlignment="Right" VerticalAlignment="Center"
                  Background="Transparent" Foreground="White"
                  BorderThickness="0"/>
        </Grid>

        <!-- 内容区（与桌面相同的 Canvas） -->
        <Grid Grid.Row="1" x:Name="RootGrid" Background="Transparent" Margin="12">
          <Grid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="自动排列" Click="Menu_AutoArrange_Click"/>
              <Separator/>
              <MenuItem Header="新建文件夹" Click="Menu_NewFolder_Click"/>
            </ContextMenu>
          </Grid.ContextMenu>

          <ItemsControl x:Name="ItemsHost" ItemsSource="{Binding Children}"
                        ItemTemplateSelector="{StaticResource ItemSelector}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Canvas Background="Transparent"
                        MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                        MouseMove="Canvas_MouseMove"
                        MouseLeftButtonUp="Canvas_MouseLeftButtonUp"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
              <Style TargetType="ContentPresenter">
                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                <Setter Property="Canvas.Top"  Value="{Binding Y}"/>
              </Style>
            </ItemsControl.ItemContainerStyle>
          </ItemsControl>

          <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False">
            <Rectangle x:Name="SnapPreview" Width="96" Height="110"
                       Stroke="#AAFFFFFF" StrokeThickness="1.5"
                       StrokeDashArray="4 3" Fill="#22FFFFFF"
                       RadiusX="3" RadiusY="3" Visibility="Collapsed"/>
            <Rectangle x:Name="RubberBand"
                       Stroke="#3399FF" StrokeThickness="1"
                       Fill="#332080DD" Visibility="Collapsed"/>
          </Canvas>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>