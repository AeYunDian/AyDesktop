<Window x:Class="AyDesktop.Views.DesktopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AyDesktop 桌面"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        ShowActivated="True" ResizeMode="NoResize"
        Width="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        Height="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        Left="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Left}"
        Top="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Top}"
        Deactivated="Window_Deactivated" KeyDown="Window_KeyDown">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="刷新" Click="Menu_Refresh_Click"/>
                <MenuItem Header="自动排列图标" Click="Menu_AutoArrange_Click"/>
                <Separator/>
                <MenuItem Header="新建文件夹" Click="Menu_NewFolder_Click"/>
                <MenuItem Header="打开监控文件夹" Click="Menu_OpenFolder_Click"/>
                <Separator/>
                <MenuItem Header="设置" Click="Menu_Settings_Click"/>
                <MenuItem Header="退出登录" Click="Menu_Logout_Click"/>
            </ContextMenu>
        </Grid.ContextMenu>

        <Border Background="{Binding BackgroundBrush}"
                Visibility="{Binding BackgroundVisibility}"/>

        <!-- ★ 用 ContentTemplate + DataTrigger 替代 ItemTemplateSelector -->
        <ItemsControl x:Name="ItemsHost" ItemsSource="{Binding Items}" Margin="12">
            <ItemsControl.RenderTransform>
                <TranslateTransform x:Name="ItemsTranslate" X="0"/>
            </ItemsControl.RenderTransform>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas Background="Transparent"
                            MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                            MouseMove="Canvas_MouseMove"
                            MouseLeftButtonUp="Canvas_MouseLeftButtonUp"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                    <Setter Property="Canvas.Top"  Value="{Binding Y}"/>
                    <!-- 默认用普通图标模板 -->
                    <Setter Property="ContentTemplate"
                            Value="{StaticResource NormalItemTemplate}"/>
                    <Style.Triggers>
                        <!-- 一旦 IsGroupMode 变化，立刻换模板，无需刷新 -->
                        <DataTrigger Binding="{Binding IsGroupMode}" Value="True">
                            <Setter Property="ContentTemplate"
                                    Value="{StaticResource GroupFolderTemplate}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>

        <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False">
            <Rectangle x:Name="SnapPreview" Width="96" Height="110"
                       Stroke="#AAFFFFFF" StrokeThickness="1.5"
                       StrokeDashArray="4 3" Fill="#22FFFFFF"
                       RadiusX="3" RadiusY="3" Visibility="Collapsed"/>
            <Rectangle x:Name="RubberBand"
                       Stroke="#3399FF" StrokeThickness="1"
                       Fill="#332080DD" Visibility="Collapsed"/>
            <Rectangle x:Name="MergeHint" Width="96" Height="110"
                       Stroke="#FFFFA500" StrokeThickness="2"
                       Fill="#22FFA500" RadiusX="3" RadiusY="3"
                       Visibility="Collapsed"/>
        </Canvas>
    </Grid>
</Window>