<Window x:Class="AyDesktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AyDesktop 登录"
        Width="440" Height="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 顶部：Logo -->
    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,24">
      <TextBlock Text="📁" FontSize="56" HorizontalAlignment="Center"/>
      <TextBlock Text="AyDesktop" FontSize="22" FontWeight="Bold"
                 HorizontalAlignment="Center" Margin="0,8,0,0"/>
      <TextBlock Text="请使用 Ay 账号登录后使用"
                 Foreground="Gray" HorizontalAlignment="Center" Margin="0,4,0,0"/>
    </StackPanel>

    <!-- 中部：状态 -->
    <StackPanel Grid.Row="1" VerticalAlignment="Center">
      <TextBlock x:Name="StatusText"
                 Text="未登录"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 Foreground="#555"/>
    </StackPanel>

    <!-- 底部：按钮 + 左下方离线提示 -->
    <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,20,0,0" Width="316">
      <!-- 按钮行 -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Button x:Name="LoginButton"
                Content="使用 Ay 账号登录"
                Padding="20,8" Margin="0,0,12,0"
                IsDefault="True"
                Click="Login_Click"/>
        <Button Content="退出"
                Padding="20,8"
                IsCancel="True"
                Click="Cancel_Click"/>
      </StackPanel>

      <!-- ★ 离线提示：跟按钮组左边缘对齐，位于按钮下方 -->
      <TextBlock x:Name="OfflineHint"
                 
                 Visibility="Collapsed"
                 Text="我没有 Internet 连接"
                 Foreground="#0078D4"
                 FontSize="13"
                 Cursor="Hand"
                 HorizontalAlignment="Right"
                 Margin="0,14,0,0"
                 MouseLeftButtonUp="OfflineMode_Click"/>
    </StackPanel>
  </Grid>
</Window>