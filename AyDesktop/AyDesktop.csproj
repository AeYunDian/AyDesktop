<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>AyDesktop</AssemblyName>
    <RootNamespace>AyDesktop</RootNamespace>
    <LangVersion>latest</LangVersion>

    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <InformationalVersion>1.0.1</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- ============================================================ -->
  <!-- 构建时读取 .env 并生成 Env.g.cs                              -->
  <!-- ============================================================ -->

  <UsingTask TaskName="GenerateEnvClass"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <EnvFile      ParameterType="System.String" Required="true" />
      <EnvLocalFile ParameterType="System.String" Required="true" />
      <OutputFile   ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
        var values = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

        // 后加载的覆盖先加载的
        foreach (var path in new[] { EnvFile, EnvLocalFile })
        {
            if (string.IsNullOrEmpty(path) || !File.Exists(path)) continue;

            foreach (var raw in File.ReadAllLines(path))
            {
                var line = raw.Trim();
                if (line.Length == 0 || line[0] == '#') continue;

                if (line.StartsWith("export ", StringComparison.Ordinal))
                    line = line.Substring(7).TrimStart();

                int eq = line.IndexOf('=');
                if (eq <= 0) continue;

                var key = line.Substring(0, eq).Trim();
                var val = line.Substring(eq + 1).Trim();

                if (val.Length >= 2 &&
                    ((val[0] == '"' && val[val.Length - 1] == '"') ||
                     (val[0] == '\'' && val[val.Length - 1] == '\'')))
                {
                    val = val.Substring(1, val.Length - 2);
                }

                if (key.Length > 0) values[key] = val;
            }
        }

        var sb = new StringBuilder();
        sb.AppendLine("// <auto-generated>");
        sb.AppendLine("// 由 AyDesktop.csproj 在构建时自动从 .env 生成。");
        sb.AppendLine("// 请勿手动修改。");
        sb.AppendLine("// </auto-generated>");
        sb.AppendLine();
        sb.AppendLine("namespace AyDesktop;");
        sb.AppendLine();
        sb.AppendLine("internal static class Env");
        sb.AppendLine("{");

        if (values.Count == 0)
        {
            sb.AppendLine("    // 未找到 .env 文件或文件为空。");
            sb.AppendLine("    // 请从 .env.example 复制一份为 .env 并填写配置，然后重新 build。");
        }
        else
        {
            foreach (var kv in values)
            {
                var escaped = kv.Value
                    .Replace("\\", "\\\\")
                    .Replace("\"", "\\\"");
                sb.Append("    public const string ");
                sb.Append(kv.Key);
                sb.Append(" = \"");
                sb.Append(escaped);
                sb.AppendLine("\";");
            }
        }

        sb.AppendLine("}");

        var dir = Path.GetDirectoryName(OutputFile);
        if (!string.IsNullOrEmpty(dir)) Directory.CreateDirectory(dir);
        File.WriteAllText(OutputFile, sb.ToString(), new UTF8Encoding(false));
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="GenerateEnvFile"
          BeforeTargets="BeforeCompile;CoreCompile"
          Inputs="$(MSBuildProjectDirectory)\.env;$(MSBuildProjectDirectory)\.env.local"
          Outputs="$(IntermediateOutputPath)Env.g.cs">
    <PropertyGroup>
      <_EnvFile>$(MSBuildProjectDirectory)\.env</_EnvFile>
      <_EnvLocalFile>$(MSBuildProjectDirectory)\.env.local</_EnvLocalFile>
      <_EnvGenerated>$(IntermediateOutputPath)Env.g.cs</_EnvGenerated>
    </PropertyGroup>

    <GenerateEnvClass
        EnvFile="$(_EnvFile)"
        EnvLocalFile="$(_EnvLocalFile)"
        OutputFile="$(_EnvGenerated)" />

    <ItemGroup>
      <Compile Include="$(_EnvGenerated)" />
      <FileWrites Include="$(_EnvGenerated)" />
    </ItemGroup>

    <Warning Condition="!Exists('$(_EnvFile)')"
             Text="未找到 .env 文件。请从 .env.example 复制一份并填写配置，然后重新 build。" />
  </Target>

</Project>